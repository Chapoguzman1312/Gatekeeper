# ---------------------------------------------------------------------------
# Gatekeeper configuration
#
# Copy to .env for local runs. On a host (Fly / Railway / Render) set these as
# secrets instead - never commit a filled-in .env.
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# The group or channel being gated. Add the bot as an admin with
# "Invite users via link" and "Ban users" permissions, then use /whereami
# inside the group to have the bot tell you this value. Supergroup ids are
# negative and start with -100.
TELEGRAM_CHAT_ID=-1001234567890

# Telegram user ids allowed to run admin commands, comma separated.
# Send /whoami to the bot in a private chat to get yours.
ADMIN_USER_IDS=11111111

# Random string. Telegram echoes it back on every webhook call so the bot can
# reject forged requests. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me

# --- Stripe -----------------------------------------------------------------

# Restricted key is fine. Needs read access to Customers and Subscriptions.
STRIPE_API_KEY=rk_live_...

# From the Stripe dashboard when you create the webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# The Payment Link customers are sent to. The bot appends its own
# client_reference_id, which is how a payment gets matched to a Telegram user.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx

# --- Behaviour --------------------------------------------------------------

# report    - log and report what WOULD happen, remove nobody. Start here.
# enforce   - actually remove members who are not entitled.
ENFORCEMENT_MODE=report

# Days a lapsed member keeps access after a failed payment before removal.
GRACE_PERIOD_DAYS=3

# How often the reconciliation sweep runs, in minutes. Webhooks do the fast
# path; this catches everything the webhooks missed.
RECONCILE_INTERVAL_MINUTES=60

# Onboarding messages, sent after a member joins. Format:
#   <hours after join>|<message>
# separated by ";;". Leave blank to send nothing.
ONBOARDING_DRIP=0|Welcome in. Start with the pinned post - it explains how the group works.;;24|Quick check: have you introduced yourself in the intro thread yet?;;72|Anything you have been stuck on this week? Reply here and I will point you at the right thread.

# --- Runtime ----------------------------------------------------------------

# Public HTTPS base URL of this service, no trailing slash. Used to register
# the Telegram webhook. Leave blank to fall back to long polling, which works
# anywhere but is slower and needs a persistent process.
PUBLIC_BASE_URL=https://your-app.fly.dev

PORT=8080

# SQLite file. On a free-tier host this MUST point at a mounted volume or you
# will lose every membership record on redeploy. See the README.
DB_PATH=/data/gatekeeper.db

LOG_LEVEL=INFO
